{
  "output": "alpha",
  "needs_frames": false,
  "default_theme": "red",
  "defaults": {
    "dir": "rtl",
    "google_fonts": ["Aref Ruqaa"],
    "draw": 0.55, "out_dur": 0.3, "roughness": 1, "double": true,
    "marks": []
  },
  "themes": {
    "red":    { "color": "#ff3b30", "width": 9, "label": "#ff3b30", "font": "Aref Ruqaa", "shadow": 0.35, "opacity": 1 },
    "yellow": { "color": "#ffd400", "width": 9, "label": "#ffd400", "font": "Aref Ruqaa", "shadow": 0.45, "opacity": 1 },
    "white":  { "color": "#ffffff", "width": 8, "label": "#ffffff", "font": "Aref Ruqaa", "shadow": 0.5, "opacity": 0.95 },
    "pen":    { "color": "#141414", "width": 5, "label": "#141414", "font": "Aref Ruqaa", "shadow": 0, "opacity": 1 },
    "seen":   { "color": "#e2c3a4", "width": 8, "label": "#ffffff", "font": "Aref Ruqaa", "shadow": 0.45, "opacity": 1 },
    "highlighter": { "color": "#ffe600", "width": 9, "label": "#ffe600", "font": "Aref Ruqaa", "shadow": 0, "opacity": 0.55 }
  },
  "tune": [
    { "path": "theme.color", "label": "color", "type": "color" },
    { "path": "theme.width", "label": "stroke width", "min": 1, "max": 30, "step": 0.5 },
    { "path": "theme.shadow", "label": "shadow", "min": 0, "max": 1, "step": 0.05 },
    { "path": "theme.opacity", "label": "opacity", "min": 0.1, "max": 1, "step": 0.05 },
    { "path": "draw", "label": "draw time", "min": 0.15, "max": 2, "step": 0.05 },
    { "path": "roughness", "label": "roughness", "min": 0, "max": 3, "step": 0.1 },
    { "path": "double", "label": "double stroke", "type": "bool" }
  ]
}
