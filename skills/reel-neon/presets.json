{
  "output": "alpha",
  "needs_frames": false,
  "default_theme": "amber",
  "defaults": {
    "dir": "rtl",
    "x": 0.5,
    "y": 0.2,
    "align": "center",
    "line_gap": 0.12,
    "max_width": 0.86,
    "in": 0,
    "out": null,
    "anim": "rise",
    "anim_dur": 0.9,
    "out_dur": 0.4,
    "stagger": 0.18,
    "outline": false,
    "glow": {
      "intensity": 1,
      "spread": 1,
      "bloom": 0.55,
      "hum": 0.03
    },
    "lines": [],
    "items": []
  },
  "themes": {
    "amber": {
      "glow": "#ffae3b",
      "core": "#fff3d6"
    },
    "seen": {
      "glow": "#ffc400",
      "core": "#ffe066"
    },
    "pink": {
      "glow": "#ff3d9a",
      "core": "#ffe3f1"
    },
    "ice": {
      "glow": "#4fc8ff",
      "core": "#e8f8ff"
    },
    "lime": {
      "glow": "#9dff4f",
      "core": "#f3ffe6"
    },
    "white": {
      "glow": "#ffffff",
      "core": "#ffffff"
    },
    "green": {
      "glow": "#2bff88",
      "core": "#eafff2"
    }
  },
  "tune": [
    {
      "path": "theme.glow",
      "label": "glow color",
      "type": "color"
    },
    {
      "path": "theme.core",
      "label": "core color",
      "type": "color"
    },
    {
      "path": "glow.intensity",
      "label": "glow intensity",
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "path": "glow.spread",
      "label": "glow spread",
      "min": 0.3,
      "max": 2.5,
      "step": 0.05
    },
    {
      "path": "glow.bloom",
      "label": "wall bloom",
      "min": 0,
      "max": 1.5,
      "step": 0.05
    },
    {
      "path": "x",
      "label": "x",
      "min": 0,
      "max": 1
    },
    {
      "path": "y",
      "label": "y",
      "min": 0,
      "max": 1
    },
    {
      "path": "line_gap",
      "label": "line gap",
      "min": -0.2,
      "max": 0.6
    },
    {
      "path": "outline",
      "label": "tube outline",
      "type": "bool"
    },
    {
      "path": "anim_dur",
      "label": "anim duration",
      "min": 0.2,
      "max": 2.5,
      "step": 0.05
    }
  ]
}