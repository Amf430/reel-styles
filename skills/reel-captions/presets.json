    "words": "words.json",
    "in": null,
    "out": null,
    "x": 0.5,
    "y": 0.72,
    "max_width": 0.86,
    "max_words": 3,
    "max_chars": 22,
    "pause_break": 0.35,
    "lead": 0.04,
    "hold": 0.25,
    "keywords": [],
    "colors": {},
    "auto_numbers": true,
    "strip_punct": true
  },
