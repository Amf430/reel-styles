  "tune": [
    {
      "path": "y",
      "label": "y",
      "min": 0,
      "max": 1
    },
    {
      "path": "theme.size",
      "label": "size",
      "min": 30,
      "max": 160,
      "step": 1
    },
    {
      "path": "max_words",
      "label": "words per phrase",
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "path": "theme.text",
      "label": "text",
      "type": "color"
    },
    {
      "path": "theme.active",
      "label": "active word",
      "type": "color"
    },
    {
      "path": "theme.hl",
      "label": "keyword",
      "type": "color"
    },
    {
      "path": "theme.stroke_w",
      "label": "outline",
      "min": 0,
      "max": 0.2,
      "step": 0.005
    },
    {
      "path": "theme.shadow",
      "label": "shadow",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "path": "theme.pop",
      "label": "pop",
      "min": 0,
      "max": 0.8,
      "step": 0.01
    },
    {
      "path": "auto_numbers",
      "label": "highlight numbers",
      "type": "bool"
    }
  ]
}